# .chezmoi.toml.tmpl — chezmoi 機器設定模板
# 第一次執行 chezmoi init / apply 時會詢問以下資訊
# 答案存在本機 ~/.config/chezmoi/chezmoi.toml，不會進 git

[apply]
  force = true

[interpreters.ps1]
  command = "pwsh"
  args    = ["-NoLogo", "-NoProfile"]

[data]
  zed_github_token = {{ promptStringOnce . "zed_github_token" "Zed GitHub Personal Access Token (留空跳過)" | quote }}
