{
    "editor.guides.bracketPairs": "active",
    "editor.fontFamily": "JetBrains Mono, Noto Sans TC, FiraCode",
    "editor.fontLigatures": true,
    "editor.minimap.enabled": true,
    "editor.minimap.renderCharacters": false,
    "editor.wordWrap": "on",
    "editor.mouseWheelZoom": true,
    "editor.fontSize": 20,
    "files.encoding": "utf8",
    "files.autoGuessEncoding": false,
    "files.insertFinalNewline": true,
    "explorer.openEditors.visible": 0,
    "terminal.integrated.profiles.windows": {
        "PowerShell -NoProfile": {
            "source": "PowerShell",
            "args": [
                "-NoProfile"
            ]
        }
    },
    "workbench.iconTheme": "material-icon-theme",
    "window.titleBarStyle": "custom",
    "git.autofetch": true,
    "git.enableSmartCommit": true,
    "git.confirmSync": false,
    "typescript.referencesCodeLens.enabled": true,
    "workbench.colorTheme": "One Dark Pro",
    "files.exclude": {
        "**/.DS_Store": true,
        "**/.gitignore": true,
        "**/.gitmodules": true,
        "**/*.3ds": true,
        "**/*.3DS": true,
        "**/*.asset": true,
        "**/*.booproj": true,
        "**/*.cubemap": true,
        "**/*.dll": true,
        "**/*.exe": true,
        "**/*.fbx": true,
        "**/*.FBX": true,
        "**/*.flare": true,
        "**/*.gif": true,
        "**/*.ico": true,
        "**/*.jpeg": true,
        "**/*.jpg": true,
        "**/*.lxo": true,
        "**/*.LXO": true,
        "**/*.ma": true,
        "**/*.MA": true,
        "**/*.mat": true,
        "**/*.meta": true,
        "**/*.mid": true,
        "**/*.midi": true,
        "**/*.obj": true,
        "**/*.OBJ": true,
        "**/*.pdf": true,
        "**/*.pidb": true,
        "**/*.png": true,
        "**/*.prefab": true,
        "**/*.psd": true,
        "**/*.suo": true,
        "**/*.tga": true,
        "**/*.tif": true,
        "**/*.tiff": true,
        "**/*.unity": true,
        "**/*.unityproj": true,
        "**/*.user": true,
        "**/*.userprefs": true,
        "**/*.wav": true,
        "build/": true,
        "Build/": true,
        "library/": true,
        "Library/": true,
        "obj/": true,
        "Obj/": true,
        "ProjectSettings/": true,
        "temp/": true,
        "Temp/": true
    },
    "editor.formatOnType": true,
    "security.workspace.trust.untrustedFiles": "open",
    "[html]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[css]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[markdown]": {
        "editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
    },
    "editor.guides.indentation": false,
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "workbench.startupEditor": "none",
    "markdown.extension.tableFormatter.enabled": false,
    "cSpell.userWords": [
        "Asseter",
        "Behaviour",
        "Cysharp",
        "Datas",
        "Deleter",
        "Dont",
        "Energys",
        "Indexs",
        "interactable",
        "Lerp",
        "Mathf",
        "Newtonsoft",
        "payline",
        "Raycaster",
        "Scriptable",
        "skiller",
        "Tweening",
        "tweens",
        "UGUI",
        "Wanin",
        "wenrong"
    ],
    "editor.suggestLineHeight": 30,
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "dotnet.navigation.navigateToDecompiledSources": true,
    "editor.maxTokenizationLineLength": 20000,
    "terminal.integrated.fontFamily": "Hack Nerd Font",
    "terminal.external.windowsExec": "C:\\Program Files\\PowerShell\\7\\pwsh.exe",
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "diffEditor.codeLens": true,
    "git.openRepositoryInParentFolders": "never",
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "claudeCode.preferredLocation": "panel",
    "outline.collapseItems": "alwaysCollapse",
    "http.systemCertificatesNode": true,
    // ========== vscode-neovim ==========
    "vscode-neovim.neovimExecutablePaths.win32": "C:\\Program Files\\Neovim\\bin\\nvim.exe",
    "vscode-neovim.compositeKeys": {
        "jj": { "command": "vscode-neovim.escape" },
        "jk": { "command": "vscode-neovim.escape" }
    },
    "editor.lineNumbers": "relative",
    "editor.cursorSurroundingLines": 5,
    "[csharp]": {
        "editor.defaultFormatter": "ms-dotnettools.csharp"
    },
    "security.allowedUNCHosts": [
        "192.168.10.5"
    ],
    "claudeCode.selectedModel": "opus",
    "chat.viewSessions.orientation": "stacked",
    "vstuc.refreshOnSave": true,
    "extensions.experimental.affinity": {
        "asvetliakov.vscode-neovim": 1
    },
    "chat.tools.terminal.autoApprove": {
        "/^code --list-extensions 2>/dev/null \\| sort$/": {
            "approve": true,
            "matchCommandLine": true
        }
    }
}
