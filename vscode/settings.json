        "Raycaster",
        "Scriptable",
        "skiller",
        "Tweening",
        "tweens",
        "UGUI",
        "Wanin",
        "wenrong"
    ],
    "editor.suggestLineHeight": 30,
    "explorer.confirmDelete": false,
    "redhat.telemetry.enabled": true,
    "codeium.enableConfig": {
        "*": true,
        "markdown": true
    },
    "explorer.confirmDragAndDrop": false,
    "dotnet.navigation.navigateToDecompiledSources": true,
    "editor.maxTokenizationLineLength": 100000000,
    "terminal.integrated.fontFamily": "Hack Nerd Font",
    "terminal.external.windowsExec": "C:\\Program Files\\PowerShell\\7\\pwsh.exe",
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "geminicodeassist.project": "ecstatic-mechanic-t757n",
    "diffEditor.codeLens": true,
    "git.openRepositoryInParentFolders": "never",
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "claudeCode.preferredLocation": "panel",
    "outline.collapseItems": "alwaysCollapse",
    "http.systemCertificatesNode": true,
    "vim.easymotion": true,
    // 駝峰命名移動：MyVariableName 用 ,w 跳到 Variable（不影響原生 w）
    "vim.camelCaseMotion.enable": true,
    // 游標形狀依模式變化：一眼看出當前在哪個模式
    "vim.cursorStylePerMode": {
        "normal": "block",
        "insert": "line",
        "visual": "block",
        "visualline": "block-outline",
        "visualblock": "block-outline",
        "replace": "underline"
    },
    // yank/delete 直接寫入系統剪貼簿（yy 後可在外部 Ctrl+V）
    "vim.useSystemClipboard": true,
    // 自動切換輸入法：Insert→保留 / Normal→英文 (1033)
    // 1028 = 繁體中文, 1033 = 英文 en-US
    "vim.autoSwitchInputMethod": {
        "enable": true,
        "defaultIM": "1033",
        "obtainIMCmd": "C:\\Users\\wenrong.huang\\tools\\im-select.exe",
        "switchIMCmd": "C:\\Users\\wenrong.huang\\tools\\im-select.exe {im}"
    },
    // Easymotion 配色（OneDark Pro 友善）
    "vim.easymotionMarkerBackgroundColor": "#0e7c7b",
    "vim.easymotionMarkerForegroundColorOneChar": "#ffffff",
    "vim.easymotionMarkerForegroundColorTwoCharFirst": "#ffd866",
    "vim.easymotionMarkerForegroundColorTwoCharSecond": "#ff6188",
    "vim.easymotionDimColor": "#5c6370",
    // 多鍵映射逾時（leader=Space 緩解 e/f 延遲感）
    "vim.timeout": 700,
    // 把常用的系統快捷鍵還給 VSCode，避免在 commit 訊息框 / 搜尋框被 Vim 攔截
    "vim.handleKeys": {
        "<C-a>": false,
        "<C-c>": false,
        "<C-v>": false,
        "<C-z>": false,
        "<C-y>": false,
        "<C-f>": false,
        "<C-s>": false,
        "<C-w>": false,
        "<C-n>": false,
        "<C-p>": false
    },
    // 設定 Leader Key 為空白鍵
    "vim.leader": " ",
    // 基礎 Vim 設定
    "vim.hlsearch": true,
    "vim.incsearch": true,
    "vim.ignorecase": true,
    "vim.smartcase": true,
    "vim.surround": true,
    // 按鍵映射 (Normal Mode Key Bindings)
    "vim.normalModeKeyBindings": [
        // --- 註解 (Commentary) ---
        {
            "before": [
                "g",
                "c",
                "c"
            ],
            "commands": [
                "editor.action.commentLine"
            ]
        },
        // --- 全文物件 (Textobj-entire) ---
        {
            "before": ["y", "a", "e"],
            "after": ["g", "g", "V", "G", "y"]
        },
        {
            "before": ["d", "a", "e"],
            "after": ["g", "g", "d", "G"]
        },
        {
            "before": ["v", "a", "e"],
            "after": ["g", "g", "V", "G"]
        },
        // --- 導航 (Navigation) ---
        {
            "before": [
                "g",
                "d"
            ],
            "commands": [
                "editor.action.revealDefinition"
            ]
        },
        {
            "before": [
                "g",
                "i"
            ],
            "commands": [
                "editor.action.goToImplementation"
            ]
        },
        {
            "before": [
                "g",
                "y"
            ],
            "commands": [
                "editor.action.goToTypeDefinition"
            ]
        },
        {
            "before": [
                "g",
                "r"
            ],
            "commands": [
                "editor.action.goToReferences"
            ]
        },
        {
            "before": [
                "]",
                "e"
            ],
            "commands": [
                "editor.action.marker.next"
            ]
        },
        {
            "before": [
                "[",
                "e"
            ],
            "commands": [
                "editor.action.marker.prev"
            ]
        },
        // --- 檔案與專案 ---
        {
            "before": [
                "<leader>",
                "f"
            ],
            "commands": [
                "workbench.action.quickOpen"
            ]
        },
        {
            "before": [
                "<leader>",
                "e"
            ],
            "commands": [
                "workbench.view.explorer"
            ]
        },
        // --- 歷史紀錄 ---
        // 註：移除 <C-o> / <C-i> 的覆寫，恢復 Vim 原生 jumplist 行為。
        // 若想用 VSCode 編輯歷史，請改用 <leader>o / <leader>i 或保留原本綁定。
        // --- 重構與編輯 ---
        {
            "before": [
                "<leader>",
                "r"
            ],
            "commands": [
                "editor.action.rename"
            ]
        },
        {
            "before": [
                "<leader>",
                "a"
            ],
            "commands": [
                "editor.action.quickFix"
            ]
        },
        {
            "before": [
                "<leader>",
                "o"
            ],
            "commands": [
                "editor.action.organizeImports"
            ]
        },
        {
            "before": [
                "<leader>",
                "c"
            ],
            "commands": [
                "editor.action.formatDocument"
            ]
        },
        {
            "before": [
                "<leader>",
                "n"
            ],
            "commands": [
                "editor.action.insertSnippet"
            ]
        },
        // --- 除錯與測試 ---
        {
            "before": [
                "<leader>",
                "b"
            ],
            "commands": [
                "editor.debug.action.toggleBreakpoint"
            ]
        },
        {
            "before": [
                "<leader>",
                "D"
            ],
            "commands": [
                "workbench.action.debug.start"
            ]
        },
        {
            "before": [
                "<leader>",
                "j"
            ],
            "commands": [
                "workbench.action.debug.stepOver"
            ]
        },
        {
            "before": [
                "<leader>",
                "i"
            ],
            "commands": [
                "workbench.action.debug.stepInto"
            ]
        },
        {
            "before": [
                "<leader>",
                "t"
            ],
            "commands": [
                "testing.runAtCursor"
            ]
        },
        // --- 視窗與其他 ---
        {
            "before": ["<leader>", "<CR>"],
            "commands": [":nohlsearch"]
        },
        // --- 全域搜尋 ---
        {
            "before": ["<leader>", "/"],
            "commands": ["workbench.action.findInFiles"]
        },
        {
            "before": ["<leader>", "g"],
            "commands": ["workbench.action.gotoSymbol"]
        },
        {
            "before": ["<leader>", "G"],
            "commands": ["workbench.action.showAllSymbols"]
        },
        // --- 視窗分割與切換 ---
        {
            "before": ["<leader>", "v"],
            "commands": ["workbench.action.splitEditor"]
        },
        {
            "before": ["<leader>", "s"],
            "commands": ["workbench.action.splitEditorDown"]
        },
        {
            "before": ["<C-h>"],
            "commands": ["workbench.action.focusLeftGroup"]
        },
        {
            "before": ["<C-l>"],
            "commands": ["workbench.action.focusRightGroup"]
        },
        {
            "before": ["<C-j>"],
            "commands": ["workbench.action.focusBelowGroup"]
        },
        {
            "before": ["<C-k>"],
            "commands": ["workbench.action.focusAboveGroup"]
        },
        // --- Buffer / Tab 切換 ---
        {
            "before": ["<S-h>"],
            "commands": ["workbench.action.previousEditor"]
        },
        {
            "before": ["<S-l>"],
            "commands": ["workbench.action.nextEditor"]
        },
        {
            "before": ["<leader>", "w"],
            "commands": ["workbench.action.closeActiveEditor"]
        }
    ],
    // Insert Mode 快速離開
    "vim.insertModeKeyBindings": [
        {
            "before": ["j", "j"],
            "after": ["<Esc>"]
        },
        {
            "before": ["j", "k"],
            "after": ["<Esc>"]
        }
    ],
    // Visual Mode 按鍵映射
    "vim.visualModeKeyBindings": [
        // 註解選取區
        {
            "before": [
                "g",
                "c"
            ],
            "commands": [
                "editor.action.commentLine"
            ]
        },
        // 縮排後保持選取
        {
            "before": ["<"],
            "after": ["<", "g", "v"]
        },
        {
            "before": [">"],
            "after": [">", "g", "v"]
        }
    ],
    "editor.lineNumbers": "relative",
    "vim.smartRelativeLine": true,
    "[csharp]": {
        "editor.defaultFormatter": "ms-dotnettools.csharp"
    },
    "security.allowedUNCHosts": [
        "192.168.10.5"
    ],
    "claudeCode.selectedModel": "opus",
    "chat.viewSessions.orientation": "stacked"
}
